# Kopieren nach .env und ausfüllen. Nie committen.
PORT=3000
# Leer lassen = nur localhost ohne Token. Gesetzt = jeder API-Aufruf braucht "Authorization: Bearer <APP_TOKEN>".
APP_TOKEN=
# Pfad der SQLite-Datei (relativ zum Repo-Root)
DB_PATH=data/alwine.db
# Feature 2 (Mail-Center)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/oauth/callback
# Feature 3 (KI-Lead-Finder)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
GOOGLE_PLACES_API_KEY=
